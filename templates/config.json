{
  "_comment": "APEX ledger config. Copy to <PROJECT_ROOT>/.apex/config.json and fill in. Keys are camelCase and must match ApexConfig exactly — a key APEX does not recognise is reported, never silently ignored.",

  "projectRoot": "REPLACE/WITH/ABSOLUTE/PATH",
  "autonomy": "GUARDED",

  "allowedPaths": ["."],
  "doNotRead": [],
  "doNotTouch": [],
  "ignore": ["node_modules/", ".git/", "dist/", "build/", "__pycache__/", ".venv/", "vendor/"],

  "sourcesOfTruth": [],

  "_verifyCommandsNote": "Tier names are exactly these. There is no 'test' or 'run' tier — the whole-project check is 'suite', and executing the thing is 'runtime'.",
  "verifyCommands": {
    "parse": null,
    "types": null,
    "lint": null,
    "unit": null,
    "suite": null,
    "build": null,
    "runtime": null
  },

  "limits": {
    "maxSameStrategyFailures": 3,
    "maxSubagentRetries": 2,
    "handoffAtContextPct": 80
  },

  "council": {
    "enabled": false,
    "reviewerModel": null,
    "conveneOn": ["security", "irreversible", "architecture", "third_failure"]
  },

  "_delegationNote": "See core/13-FLEET.md. mode: OFF | AUTO | DIRECTED_ONLY | AGGRESSIVE",
  "delegation": {
    "mode": "AUTO",
    "maxConcurrentCalls": 6,
    "maxLogicalPackets": 200,
    "writersPerWave": 1,
    "isolation": "none",
    "models": {
      "commander": null,
      "workers": [],
      "reviewer": null,
      "allowSubstitution": false,
      "fallback": {}
    },
    "onClassExhausted": "ask_user",
    "announceAutonomous": true
  }
}
